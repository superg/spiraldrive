{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build fwpatch-plextor",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "--locked",
        "--manifest-path",
        "tools/fwpatch-plextor/Cargo.toml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
