; Native power-down entry sequence.
$CASE
NAME POWER_CONTROL

PUBLIC EnterPowerDownModeWithInterruptsEnabled?

GLOBAL_INTERRUPT_ENABLE BIT 0AFH
POWER_CONTROL_REGISTER DATA 087H

POWER_CONTROL SEGMENT ECODE
RSEG POWER_CONTROL

; RAM:fee8a8
EnterPowerDownModeWithInterruptsEnabled?:
    SETB GLOBAL_INTERRUPT_ENABLE
    ORL POWER_CONTROL_REGISTER,#02H
    NOP
    NOP
    ERET

END
