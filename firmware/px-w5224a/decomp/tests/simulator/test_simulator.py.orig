    def test_reconstructed_parameters_are_recovered_from_listing_prologue(self):
        listing_text = """\
; FUNCTION Example? (BEGIN)
000000 7CAB           MOV      R10,R11
;---- Variable 'value' assigned to Register 'R10' ----
000002 7F01           MOV      DR0,DR4
;---- Variable 'port_address' assigned to Register 'DR0' ----
000004 AA             ERET
; FUNCTION Example? (END)
"""
        with tempfile.TemporaryDirectory() as temporary:
            listing = Path(temporary) / "example.lst"
            listing.write_text(listing_text, encoding="ascii")
            parameters = simulator.dependency_parameters(
                {
                    "symbol": "Example",
                    "parameters": [
                        "portAddress:uint:DR0:4",
                        "value:uchar:ACC:1",
                    ],
                },
                "reconstructed",
                listing,
                "Example",
            )
        self.assertEqual(
            parameters,
            (("portAddress", "DR4", 4), ("value", "R11", 1)),
        )

