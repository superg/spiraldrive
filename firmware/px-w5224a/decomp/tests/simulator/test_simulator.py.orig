    def test_indexed_toc_reset_declares_inherited_b_and_direct_worker(self):
        metadata = simulator.load_metadata(
            ROOT / "tests/simulator/metadata/W5224A104.json"
        )
        function = simulator.metadata_function(metadata, "0xfba0bb")
        self.assertEqual(
            function["parameters"],
            [
                "reinitializeController:bool:ACC:1",
                "firstPointIndex:uchar:B:1",
            ],
        )
        overrides = json.loads(
            (ROOT / "tests/simulator/cases/generated-overrides.json").read_text()
        )["overrides"]
        self.assertEqual(
            overrides["0xfba0bb"]["dependency_reconstructed_symbols"][
                "RAM:fba4f7"
            ],
            "ResetTocAcquisitionStateFromPointIndexAndFinalize",
        )
        self.assertEqual(
            overrides["0xfba802"]["dependency_memory_writes"]["RAM:fc818b"],
            [{"address": "0x001203", "bytes": [0]}],
        )
        self.assertEqual(overrides["0xfbad3e"]["instruction_limit"], 200000)
        self.assertEqual(
            overrides["0xfbd7d6"]["dependency_memory_writes"]["RAM:fee529"],
            [{"address": "0x000e40", "bytes": [0]}],
        )
        self.assertEqual(overrides["0xfbdef0"]["dependencies"], [])
        self.assertEqual(
            overrides["0xfbf161"]["dependency_memory_writes"]["RAM:fee529"],
            [{"address": "0x001208", "bytes": [255]}],
        )
        self.assertEqual(
            overrides["0xfbfbb9"]["dependency_memory_writes"]["RAM:fee529"],
            [{"address": "0x0015c3", "bytes": [1]}],
        )
        self.assertEqual(overrides["0xfbfe72"]["registers"], {"DR4": 12288})
        self.assertEqual(
            overrides["0xfbfe72"]["memory"],
            [
                {"address": "0x003002", "bytes": [49, 0]},
                {"address": "0x003100", "bytes": [0, 0]},
            ],
        )
        self.assertEqual(
            overrides["0xfc549f"]["dependency_memory_writes"]["RAM:fee529"],
            [{"address": "0x001462", "bytes": [0]}],
        )
        self.assertEqual(
            overrides["0xfc6019"]["additional_dependencies"],
            [
                {
                    "function": "RAM:fc6247",
                    "return": {"register": "R11", "value": 0},
                }
            ],
        )
        self.assertEqual(
            [
                patch["reconstructed_symbol"]
                for patch in overrides["0xfc69ac"]["code_patches"][:2]
            ],
            [
                "CompressThirtyNineFramePositionToLogicalBlockAddress",
                "ExpandLogicalBlockAddressToThirtyNineFramePosition",
            ],
        )
        self.assertTrue(
            all(
                patch["stock_bytes"][-1] == 0x22
                and patch["reconstructed_bytes"][-1] == 0xAA
                for patch in overrides["0xfc69ac"]["code_patches"][:2]
            )
        )
        self.assertEqual(
            overrides["0xfc69ac"]["code_patches"][2]["reconstructed_offset"],
            0x70,
        )
        self.assertEqual(
            overrides["0xfc69ac"]["code_patches"][3]["reconstructed_offset"],
            0x315,
        )
        self.assertEqual(
            overrides["0xfc69ac"]["registers"], {"SP": 0x07, "SPH": 0x05}
        )
        self.assertTrue(overrides["0xfc69ac"]["stop_before_return"])
        self.assertEqual(
            overrides["0xfcd2f0"]["dependency_reconstructed_symbols"],
            {
                "RAM:fcd912": "FinalizeType2MipRecordComparisonStateForBoundaryBuild",
                "RAM:fcda9d": "BuildMipType2ControllerRecordBoundaryTableWithInheritedCount",
            },
        )
        self.assertEqual(
            overrides["0xfcd2f0"]["code_patches"][1]["stock_bytes"],
            [0, 0, 0],
        )
        self.assertEqual(
            overrides["0xfcd2f0"]["code_patches"][-1][
                "reconstructed_jump_offset"
            ],
            0x14F,
        )
        self.assertEqual(overrides["0xfcdc24"]["instruction_limit"], 300000)
        self.assertEqual(
            overrides["0xfcdc24"]["dependency_reconstructed_symbols"],
            {"RAM:fcd87e": "CopyControllerBufferPageToUpperBankedRegionForC"},
        )
        self.assertEqual(
            overrides["0xfcf967"]["additional_dependencies"], ["RAM:fcfda0"]
        )
        self.assertEqual(
            overrides["0xfcfa0e"]["additional_dependencies"], ["RAM:fcfda0"]
        )
        self.assertEqual(
            overrides["0xfcfda0"]["registers"], {"R11": 0, "DR0": 0x123D}
        )
        self.assertEqual(
            [
                dependency["function"]
                for dependency in overrides["0xfcfda0"]["additional_dependencies"]
            ],
            ["RAM:fb9d48", "RAM:fee841"],
        )
        self.assertEqual(
            overrides["0xfc6e53"]["code_patches"][0]["reconstructed_offset"],
            0x5AB,
        )

