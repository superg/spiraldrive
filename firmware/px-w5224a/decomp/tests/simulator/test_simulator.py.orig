    def test_execution_script_resets_before_declared_state(self):
        case = {
            "id": "reset-order",
            "termination": "eret",
            "registers": {"R7": 0x5A},
            "memory": [{"address": "0x001000", "bytes": [0xA5]}],
            "observe": {"registers": {}, "memory": []},
