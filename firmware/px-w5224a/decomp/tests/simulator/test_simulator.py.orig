    def test_indexed_state_reference_validation_declares_hdata_bank_2b(self):
        metadata = simulator.load_metadata(
            ROOT / "tests/simulator/metadata/W5224A104.json"
        )
        for address in ("0xfb40e9", "0xfb8c0e", "0xfbad3e", "0xfc2a37"):
            function = simulator.metadata_function(metadata, address)
            self.assertEqual(function["simulator_hdata_banks"], [0x2B])
        controller_copy = simulator.metadata_function(metadata, "0xfddd78")
        self.assertEqual(controller_copy["simulator_hdata_banks"], [0x10])
        self.assertEqual(
            simulator.simulator_hdata_relocations(controller_copy), {0x10: 0x01}
        )
        for address in ("0xfbf736", "0xfbfe72", "0xfc627c"):
            window_function = simulator.metadata_function(metadata, address)
            self.assertEqual(
                simulator.simulator_hdata_relocations(window_function),
                {0x10: 0x01},
            )
        for address in ("0xfc69ac", "0xfc6e53"):
            function = simulator.metadata_function(metadata, address)
            self.assertEqual(
                simulator.simulator_hdata_relocations(function),
                {0x19: 1, 0x2B: 0},
            )
        for address in ("0xfc766a", "0xfc7766"):
            function = simulator.metadata_function(metadata, address)
            self.assertEqual(
                simulator.simulator_hdata_relocations(function),
                {0x10: 0x01, 0x2B: 0},
            )

