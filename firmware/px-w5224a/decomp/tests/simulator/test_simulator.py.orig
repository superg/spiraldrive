    def test_dependency_stub_supports_multiple_return_registers(self):
        metadata = {
            "functions": [
                {
                    "canonical_address": "0xf90000",
                    "symbol": "Caller",
                    "calls": ["RAM:fd9602"],
                },
                {
                    "canonical_address": "0xfd9602",
                    "symbol": "Divide",
                    "parameters": [],
                    "return_sites": ["RAM:fd9637:eret"],
                    "reconstructed_return_kinds": ["eret"],
                },
            ]
        }
        case = {
            "id": "multi-return",
            "mode": "isolated",
            "dependencies": [
                {
                    "function": "RAM:fd9602",
                    "returns": [
                        {"register": "DR4", "value": 3},
                        {"register": "DR0", "value": 1},
                    ],
                }
            ],
        }
        stubs, _, tracepoints = simulator.resolve_dependency_stubs(
            case, metadata["functions"][0], metadata, {}, "stock"
        )
        self.assertEqual(stubs[0][2], [("DR4", 3), ("DR0", 1)])
        self.assertEqual(
            tracepoints[0].assignments, (("DR4", 3), ("DR0", 1))
        )

