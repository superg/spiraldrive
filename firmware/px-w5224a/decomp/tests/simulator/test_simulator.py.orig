    def test_unexpected_execution_stop_is_a_differential_result(self):
        case = {
            "id": "unexpected-stop",
            "termination": "eret",
            "instruction_limit": 10,
            "snapshot_near": False,
            "snapshot_controller": False,
            "observe": {"registers": {}, "memory": []},
        }
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            result_path = directory / "result.hex"
            result = bytearray(
                simulator.EXECUTION_STACK_STATE_OFFSET + 2 + 0x20
            )
            result[0] = 0xA5
            result[1:5] = (0xFB625B).to_bytes(4, "big")
            state_offset = 0x20
            result[state_offset + 4 : state_offset + 8] = (2).to_bytes(4, "big")
            result_path.write_text(
                simulator.intel_hex(bytes(result), 0x017F00), encoding="ascii"
            )
            decoded = simulator.decode_execution_result(
                case, result_path, 0xF70004
            )
        self.assertEqual(decoded["termination"], "unexpected@0xfb625b")
        self.assertEqual(decoded["stack"]["boundary"], "unexpected")
        self.assertIn("DR0", decoded["stop_diagnostics"])

    def test_memory_relocation_materializes_image_pointer_and_stock_mirror(self):
        case = {
            "id": "relocated-buffer",
            "function": "0xfdb4d9",
            "mode": "isolated",
            "termination": "ret",
            "instruction_limit": 10,
            "origin": "unit test",
            "memory": [],
            "hardware_reads": [{"space": "SFR", "address": "0x91", "values": [1, 2]}],
            "stock_hardware_reads": [
                {"space": "SFR", "address": "0x91", "values": [1]}
            ],
            "memory_relocations": [
                {
                    "name": "payload",
                    "pointer_address": "0x00155a",
                    "stock_base": "0x160000",
                    "reconstructed_base": "0x018000",
                    "offset": 16,
                    "length": 512,
                }
            ],
        }
        simulator.validate_case(case, Path("case.json"))
        stock = simulator.materialize_memory_relocations(case, "stock")
        reconstructed = simulator.materialize_memory_relocations(
            case, "reconstructed"
        )
        self.assertEqual(stock["memory"][-1]["bytes"], [0, 22, 0, 0])
        self.assertEqual(reconstructed["memory"][-1]["bytes"], [0, 1, 128, 0])
        self.assertEqual(
            stock["_post_execution_copies"],
            [{"source": 0x160010, "destination": 0x018010, "length": 512}],
        )
        self.assertEqual(reconstructed["_post_execution_copies"], [])
        self.assertEqual(stock["hardware_reads"][0]["values"], [1])
        self.assertEqual(reconstructed["hardware_reads"][0]["values"], [1, 2])

    def test_code_pointer_memory_normalizes_linked_addresses(self):
        case = {
            "id": "code-pointer",
            "termination": "ret",
            "instruction_limit": 10,
            "observe": {"registers": {}, "memory": []},
            "memory": [],
            "snapshot_controller": False,
            "code_pointer_memory": [
                {"name": "worker", "address": "0x001700"}
            ],
        }
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            result_path = directory / "result.hex"
            result = bytearray(
                simulator.EXECUTION_STACK_STATE_OFFSET + 2 + 0x20
            )
            result[0] = 0xA5
            result_path.write_text(
                simulator.intel_hex(bytes(result), 0x017F00), encoding="ascii"
            )
            before = bytes(0x10000 - 0x420)
            after = bytearray(before)
            after[0x1700 - 0x420 : 0x1704 - 0x420] = (0xFE1234).to_bytes(
                4, "big"
            )
            for name, contents in (("before", before), ("after", bytes(after))):
                (directory / f"ram-{name}-near.hex").write_text(
                    simulator.intel_hex(contents, 0x420), encoding="ascii"
                )
            materialized = simulator.materialize_memory_relocations(
                case, "reconstructed", {0xFE1234: 0xF81234}
            )
            decoded = simulator.decode_execution_result(
                materialized, result_path, 0
            )
        self.assertEqual(decoded["memory"]["worker"], "0xf81234")
        self.assertEqual(decoded["memory"]["$ram_delta"], {})

    def test_execution_script_mirrors_relocated_stock_result_after_run(self):
        case = {
            "id": "relocated-buffer",
            "termination": "ret",
            "registers": {},
            "memory": [],
            "observe": {"registers": {}, "memory": []},
            "_post_execution_copies": [
                {"source": 0x160010, "destination": 0x018010, "length": 2}
            ],
        }
        with tempfile.TemporaryDirectory() as temporary:
            script, _ = simulator.render_execution_script(
                case,
                0xFDB4D9,
                0xFDB786,
                Path(temporary) / "result.hex",
                None,
                None,
            )
        run = "G C:0xfdb4d9,C:0xfdfffc"
        copy = "_WBYTE(0x018010, _RBYTE(0x160010))"
        snapshot = 'SAVE "'
        self.assertIn(run, script)
        self.assertIn(copy, script)
        self.assertLess(script.index(run), script.index(copy))
        self.assertLess(script.index(copy), script.index(snapshot, script.index(copy)))

    def test_execution_script_projects_private_register_results_before_snapshot(self):
        case = {
            "id": "private-register-result",
            "termination": "ret",
            "registers": {},
            "memory": [],
            "observe": {"registers": {}, "memory": []},
            "_result_projections": [
                {"address": "0x001700", "register": "WR0", "width": 2},
                {"address": "0x001708", "register": "F0", "width": 1},
            ],
        }
        with tempfile.TemporaryDirectory() as temporary:
            script, _ = simulator.render_execution_script(
                case,
                0xFD91E2,
                0xFD9204,
                Path(temporary) / "result.hex",
                None,
                None,
            )
        run = "G C:0xfd91e2,C:0xfdfffc"
        word_projection = "_WWORD(E:0x001700, WR0)"
        flag_projection = "_WBYTE(E:0x001708, F0)"
        snapshot = 'SAVE "'
        self.assertIn(word_projection, script)
        self.assertIn(flag_projection, script)
        self.assertLess(script.index(run), script.index(word_projection))
        self.assertLess(
            script.index(flag_projection),
            script.index(snapshot, script.index(flag_projection)),
        )

