    def test_dependency_trace_shim_applies_declared_near_memory_writes(self):
        tracepoint = simulator.DependencyTracepoint(
            0xFEE534,
            "0xfee534",
            (),
            1,
            "eret",
            memory_writes=((0x120A, 0xFF), (0x1220, 0x00)),
            bit_writes=((0x09, 1),),
        )
        assembly, _ = simulator.render_dependency_trace_assembly([tracepoint])
        self.assertIn("MOV R15,#0FFH", assembly)
        self.assertIn("MOV EDATA 0120AH,R15", assembly)
        self.assertIn("MOV R15,#000H", assembly)
        self.assertIn("MOV EDATA 01220H,R15", assembly)
        self.assertIn("SETB 009H", assembly)

    def test_dependency_trace_shim_captures_b_through_scratch_register(self):
        tracepoint = simulator.DependencyTracepoint(
            0xFBA4F7,
            "0xfba4f7",
            (("firstPointIndex", "B", 1),),
            1,
            "eret",
        )
        assembly, _ = simulator.render_dependency_trace_assembly([tracepoint])
        self.assertIn("MOV R15,B\n    MOV EDATA 045D7H,R15", assembly)
        self.assertNotIn("MOV EDATA 045D7H,B", assembly)

    def test_dependency_trace_shim_does_not_save_unused_b_register(self):
        tracepoint = simulator.DependencyTracepoint(
            0xFEE534,
            "0xfee534",
            (),
            1,
            "eret",
        )
        assembly, _ = simulator.render_dependency_trace_assembly([tracepoint])
        self.assertNotIn("PUSH B", assembly)
        self.assertNotIn("POP B", assembly)

    def test_dependency_trace_shim_captures_memory_backed_parameter(self):
        tracepoint = simulator.DependencyTracepoint(
            0xF849DE,
            "0xf849de",
            (("exclusiveEnd", "XDATA@0x011a8b", 1),),
            1,
            "eret",
        )
        assembly, _ = simulator.render_dependency_trace_assembly([tracepoint])
        self.assertIn(
            "MOV DPTR,#0011A8BH\n    MOVX A,@DPTR\n    MOV EDATA 045D7H,A",
            assembly,
        )

    def test_ret_stack_frame_is_installed_after_reset(self):
        case = {
            "id": "ret-frame",
            "termination": "ret",
            "registers": {},
            "memory": [],
            "observe": {"registers": {}, "memory": []},
        }
        with tempfile.TemporaryDirectory() as temporary:
            script, _ = simulator.render_execution_script(
                case,
                0xF84CB1,
                0xF84D24,
                Path(temporary) / "result.hex",
                None,
                None,
            )
        self.assertLess(script.index("RESET"), script.index("SP = 0x60"))
        self.assertLess(script.index("RESET"), script.index("_WBYTE(I:0x61"))

    def test_internal_bit_initialization_uses_bit_addressable_data_byte(self):
        case = {
            "id": "initial-bit",
            "termination": "eret",
            "registers": {},
            "memory": [],
            "bits": [{"address": "0x0009", "value": 1}],
            "observe": {"registers": {}, "memory": []},
        }
        with tempfile.TemporaryDirectory() as temporary:
            script, _ = simulator.render_execution_script(
                case,
                0xF80000,
                0xF80010,
                Path(temporary) / "result.hex",
                None,
                None,
            )
        self.assertIn(
            "_WBYTE(I:0x21, _RBYTE(I:0x21) | 0x02)", script
        )

    def test_generated_project_does_not_restore_debugger_state(self):
        base = Path(
            "/home/hbrych/.wine/drive_c/Keil_v5/C251/Examples/Blinky/BLINKY.uvproj"
        )
        if not base.is_file():
            self.skipTest("Keil example project is not installed")
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            project = directory / "run.uvproj"
            simulator.create_project(base, project, directory / "run.ini", None)
            root = ET.parse(project).getroot()
        selected = root.find("./Targets/Target")
        self.assertIsNotNone(selected)
        for name in (
            "RestoreBreakpoints",
            "RestoreWatchpoints",
            "RestoreMemoryDisplay",
            "RestoreFunctions",
            "RestoreToolbox",
        ):
            self.assertEqual(
                selected.findtext(f"./TargetOption/DebugOption/Simulator/{name}"),
                "0",
            )

    def test_comparison_normalizes_image_and_program_counter(self):
        stock = {
            "termination": "eret",
            "registers": {"R11": 3},
            "flags": {"C": 0},
            "stack": [],
            "memory": {},
            "trace": [{"operation": "read", "address": "0x18080", "value": 4, "pc": "0xf80000", "image": "stock"}],
        }
        reconstructed = json.loads(json.dumps(stock))
        reconstructed["trace"][0]["pc"] = "0xfa0000"
        reconstructed["trace"][0]["image"] = "reconstructed"
        self.assertEqual(simulator.compare_results(stock, reconstructed), [])

    def test_comparison_detects_every_observable_category(self):
        base = {
            "termination": "ret",
            "registers": {"R7": 1},
            "flags": {"C": 0},
            "stack": [1, 2],
            "memory": {"0x001000": 3},
            "trace": [{"operation": "write", "address": "0x018080", "value": 4}],
        }
        for key in ("termination", "registers", "flags", "stack", "memory", "trace"):
            changed = json.loads(json.dumps(base))
            if key == "trace":
                changed[key][0]["value"] = 5
            else:
                changed[key] = "different"
            differences = simulator.compare_results(base, changed)
            self.assertTrue(any(item.startswith(key + ":") for item in differences), key)

    def test_comparison_can_ignore_pre_return_stack_only(self):
        stock = {
            "termination": "eret",
            "registers": {"R11": 3},
            "flags": {},
            "stack": {"balanced": False, "residual": 1},
            "memory": {},
            "trace": [],
        }
        reconstructed = json.loads(json.dumps(stock))
        reconstructed["stack"]["residual"] = 2
        self.assertTrue(
            any(
                difference.startswith("stack:")
                for difference in simulator.compare_results(stock, reconstructed)
            )
        )
        case = {
            "ignored_stack": {
                "reason": "Compiler-specific pre-return frames are not outputs."
            }
        }
        self.assertEqual(
            simulator.compare_results(stock, reconstructed, case), []
        )

    def test_code_patch_resolves_symbol_relative_jump(self):
        case = {
            "id": "relative-jump",
            "code_patches": [
                {
                    "reconstructed_symbol": "Worker",
                    "reconstructed_offset": 4,
                    "reconstructed_jump_offset": 0x123,
                    "reason": "unit test",
                }
            ],
        }
        self.assertEqual(
            simulator.resolve_code_patches(
                case, {"Worker": 0xF80000}, "reconstructed"
            ),
            [(0xF80004, [0x8A, 0xF8, 0x01, 0x23])],
        )

    def test_comparison_detects_hardware_access_order(self):
        stock = {
            "termination": "eret",
            "registers": {},
            "flags": {},
            "stack": [],
            "memory": {},
            "trace": [],
            "hardware_trace": [
                {"operation": "read", "space": "SFR", "address": "0x0091", "value": 1},
                {"operation": "read", "space": "SFR", "address": "0x0091", "value": 2},
            ],
        }
        reconstructed = json.loads(json.dumps(stock))
        reconstructed["hardware_trace"].reverse()
        differences = simulator.compare_results(stock, reconstructed)
        self.assertTrue(
            any(item.startswith("hardware_trace:") for item in differences)
        )

    def test_prepare_writes_pinned_image_provenance(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            stock = directory / "stock.bin"
            monitor = directory / "monitor.bin"
            stock.write_bytes(b"\xff" * 0x80000)
            monitor.write_bytes(b"\0" * 0x10000)
            args = type("Arguments", (), {"stock": stock, "monitor": monitor, "output": directory / "out"})()
            self.assertEqual(simulator.command_prepare(args), 0)
            provenance = json.loads((args.output / "images.json").read_text())
            self.assertEqual(provenance["stock"]["sha256"], simulator.sha256(stock))

    def test_prepare_needs_only_the_stock_image(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            stock = directory / "stock.bin"
            stock.write_bytes(b"\xff" * 0x80000)
            args = type(
                "Arguments",
                (),
                {"stock": stock, "monitor": None, "output": directory / "out"},
            )()
            self.assertEqual(simulator.command_prepare(args), 0)
            provenance = json.loads((args.output / "images.json").read_text())
            self.assertIsNone(provenance["monitor"])
            self.assertFalse((args.output / "monitor.hex").exists())


if __name__ == "__main__":
    unittest.main()
