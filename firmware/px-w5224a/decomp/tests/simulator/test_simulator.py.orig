    def test_hardware_read_signal_supplies_ordered_values(self):
        case = {
            "id": "hardware-read",
            "hardware_reads": [
                {
                    "space": "SFR",
                    "address": "0xd7",
                    "width": 1,
                    "values": [0x11, 0],
                }
            ],
        }
        definitions, starts = simulator.render_hardware_read_signals(case)
        script = "\n".join(definitions)
        self.assertIn("rwatch(D:0xd7)", script)
        self.assertIn("if (_RBYTE(0x017003) == 0)", script)
        self.assertIn("_WBYTE(D:0xd7, 17)", script)
        self.assertIn("_WBYTE(D:0xd7, 0)", script)
        self.assertIn("_WBYTE(0x017004 + event * 8, 3)", script)
        self.assertEqual(starts, ["PlextorHardwareRead0()"])

    def test_hardware_write_signal_records_cpu_value(self):
        case = {
            "id": "hardware-write",
            "hardware_writes": [
                {"space": "CONTROLLER", "address": "0x018080", "value": 0x55}
            ],
        }
        definitions, starts = simulator.render_hardware_write_signals(case, 0)
        script = "\n".join(definitions)
        self.assertIn("wwatch(0x018080)", script)
        self.assertIn("if (_RBYTE(0x017003) == 0)", script)
        self.assertIn("value = _RBYTE(0x018080)", script)
        self.assertIn("_WBYTE(0x017004 + event * 8, 2)", script)
        self.assertEqual(starts, ["PlextorHardwareWrite0()"])

