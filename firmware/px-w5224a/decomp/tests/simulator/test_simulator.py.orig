    def test_controller_record_cases_ignore_verified_compiler_local_tuples(self):
        overrides = json.loads(
            (ROOT / "tests/simulator/cases/generated-overrides.json").read_text()
        )["overrides"]
        reason = (
            "Reconstructed C251 three-byte automatic packed-MSF tuple; a "
            "write watchpoint localizes its final byte to IncrementPackedBcdMsf, "
            "and the normalized dependency trace and persistent outputs match."
        )
        expected = {
            "0xfa0000": "0x000b55",
            "0xfa05ef": "0x000b46",
            "0xfa0ab4": "0x000a28",
            "0xfa1341": "0x000a18",
            "0xfa1ac5": "0x000b37",
            "0xfa20f3": "0x000f0a",
            "0xfa24e9": "0x000b28",
            "0xfa299d": "0x000678",
        }
        for function, address in expected.items():
            with self.subTest(function=function):
                self.assertEqual(
                    overrides[function]["ignored_memory"][0],
                    {"address": address, "length": 3, "reason": reason},
                )

