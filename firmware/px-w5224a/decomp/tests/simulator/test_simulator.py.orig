    def test_dependency_trace_script_and_decoder_use_canonical_identity(self):
        tracepoint = simulator.DependencyTracepoint(
            0xF8A934,
            "0xf8a934",
            (("portAddress", "DR0", 4), ("value", "R11", 1)),
            42,
            "eret",
        )
        case = {
            "id": "trace",
            "termination": "eret",
            "registers": {},
            "memory": [],
            "observe": {"registers": {}, "memory": []},
        }
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            script, _ = simulator.render_execution_script(
                case,
                0xF80000,
                0xF80010,
                directory / "result.hex",
                None,
                None,
                dependency_stubs=[(0xF8A934, "eret", [])],
                dependency_tracepoints=[tracepoint],
                dependency_trace_overlay=directory / "trace.abs",
                dependency_trace_shims={0xF8A934: 0xF60076},
            )
            self.assertIn('_WBYTE(0xf8a934, 0x8a)', script)
            self.assertIn('_WBYTE(0xf8a937, 0x76)', script)
            memory = bytearray(24)
            memory[1] = 1
            memory[4:6] = (42).to_bytes(2, "big")
            memory[6] = 2
            memory[8:12] = (0x018006).to_bytes(4, "big")
            memory[12:16] = (0xC0).to_bytes(4, "big")
            trace = directory / "trace.hex"
            trace.write_text(
                simulator.intel_hex(bytes(memory), simulator.DEPENDENCY_TRACE_BASE)
            )
            decoded = simulator.decode_dependency_trace(trace, [tracepoint])
        self.assertEqual(
            decoded,
            [
                {
                    "operation": "call",
                    "function": "0xf8a934",
                    "arguments": {"portAddress": 0x018006, "value": 0xC0},
                }
            ],
        )

    def test_dependency_trace_normalizes_relocated_code_argument(self):
        tracepoint = simulator.DependencyTracepoint(
            0xFEE4C1,
            "0xfee4c1",
            (("entryPoint", "DR0", 4),),
            7,
            "eret",
            code_parameters=("entryPoint",),
        )
        with tempfile.TemporaryDirectory() as temporary:
            trace = Path(temporary) / "trace.hex"
            memory = bytearray(24)
            memory[1] = 1
            memory[4:6] = (7).to_bytes(2, "big")
            memory[6] = 1
            memory[8:12] = (0xFE5547).to_bytes(4, "big")
            trace.write_text(
                simulator.intel_hex(bytes(memory), simulator.DEPENDENCY_TRACE_BASE)
            )
            decoded = simulator.decode_dependency_trace(
                trace, [tracepoint], {0xFE5547: 0xF853CF}
            )
        self.assertEqual(decoded[0]["arguments"]["entryPoint"], 0xF853CF)

