    def test_materialize_memory_relocations_applies_image_specific_cpu_state(self):
        case = {
            "id": "abi-state",
            "registers": {"SP": 7, "WR0": 1},
            "stock_registers": {"DR0": 0x1234},
            "reconstructed_registers": {"WR0": 2},
            "internal_memory": [{"address": "0x20", "bytes": [3]}],
            "stock_internal_memory": [{"address": "0x07", "bytes": [0, 4]}],
            "stock_result_projections": [
                {"address": "0x1700", "register": "WR0", "width": 2}
            ],
            "memory": [],
            "memory_relocations": [],
        }

        stock = simulator.materialize_memory_relocations(case, "stock")
        reconstructed = simulator.materialize_memory_relocations(
            case, "reconstructed"
        )

        self.assertEqual(stock["registers"], {"SP": 7, "WR0": 1, "DR0": 0x1234})
        self.assertEqual(
            stock["internal_memory"],
            [
                {"address": "0x20", "bytes": [3]},
                {"address": "0x07", "bytes": [0, 4]},
            ],
        )
        self.assertEqual(
            stock["_result_projections"],
            [{"address": "0x1700", "register": "WR0", "width": 2}],
        )
        self.assertEqual(reconstructed["registers"], {"SP": 7, "WR0": 2})
        self.assertEqual(
            reconstructed["internal_memory"],
            [{"address": "0x20", "bytes": [3]}],
        )
        self.assertEqual(reconstructed["_result_projections"], [])

