    def test_hdata_relocation_reaches_integrated_callees(self):
        metadata = simulator.load_metadata(
            ROOT / "tests/simulator/metadata/W5224A104.json"
        )
        root = simulator.metadata_function(metadata, "0xfa0ab4")
        case = {
            "dependencies": [
                "RAM:fe17b1",
                "RAM:fa286a",
                "RAM:fe2aa0",
                "RAM:fbff86",
            ]
        }
        firmware = ROOT / "out/agent-tests/simulator-no-ghidra/firmware"
        if not (firmware / "main.map").is_file():
            self.skipTest("reconstructed Keil map is not available")
        stock_patches, reconstructed_patches = (
            simulator.automatic_hdata_relocation_patches(
                case,
                root,
                metadata,
                simulator.parse_keil_map(firmware / "main.map"),
                simulator.index_listings(firmware),
                ROOT / "data/W5224A104/MONT_104.bin",
            )
        )
        self.assertTrue(stock_patches)
        self.assertIn((0xFD6C78, [0, 0]), reconstructed_patches)

        page_update = simulator.metadata_function(metadata, "0xfa4776")
        _, page_update_patches = simulator.automatic_hdata_relocation_patches(
            {"dependencies": []},
            page_update,
            metadata,
            simulator.parse_keil_map(firmware / "main.map"),
            simulator.index_listings(firmware),
            ROOT / "data/W5224A104/MONT_104.bin",
        )
        self.assertIn((0xF9EF83, [0, 0]), page_update_patches)

        for address in ("0xfa56c5", "0xfa5c30"):
            reconciler = simulator.metadata_function(metadata, address)
            _, reconciler_patches = simulator.automatic_hdata_relocation_patches(
                {"dependencies": []},
                reconciler,
                metadata,
                simulator.parse_keil_map(firmware / "main.map"),
                simulator.index_listings(firmware),
                ROOT / "data/W5224A104/MONT_104.bin",
            )
            self.assertIn((0xFA880D, [0, 0]), reconciler_patches)

        range_anchors = simulator.metadata_function(metadata, "0xfab306")
        _, range_anchor_patches = simulator.automatic_hdata_relocation_patches(
            {"dependencies": ["RAM:faaa8c", "RAM:fe01d3"]},
            range_anchors,
            metadata,
            simulator.parse_keil_map(firmware / "main.map"),
            simulator.index_listings(firmware),
            ROOT / "data/W5224A104/MONT_104.bin",
        )
        self.assertIn((0xFD1E5C, [0, 1]), range_anchor_patches)
        self.assertEqual(
            simulator.hdata_bank_instruction_patch(
                bytes.fromhex("4e502b"), {0x2B}
            ),
            2,
        )
        self.assertIsNone(
            simulator.hdata_bank_instruction_patch(
                bytes.fromhex("4e502b"), {0x19}
            )
        )
        full_toc_workspace = simulator.metadata_function(metadata, "0xfbad3e")
        _, full_toc_patches = simulator.automatic_hdata_relocation_patches(
            {"dependencies": []},
            full_toc_workspace,
            metadata,
            simulator.parse_keil_map(firmware / "main.map"),
            simulator.index_listings(firmware),
            ROOT / "data/W5224A104/MONT_104.bin",
        )
        self.assertIn((0xF91289, [0]), full_toc_patches)

