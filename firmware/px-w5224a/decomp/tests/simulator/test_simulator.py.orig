        with tempfile.TemporaryDirectory() as temporary:
            script, _ = simulator.render_execution_script(
                case,
                0xF80000,
                0xF80010,
                Path(temporary) / "result.hex",
                None,
                None,
            )
        self.assertLess(script.index("RESET"), script.index("R7 = 90"))
        self.assertLess(script.index("RESET"), script.index("_WBYTE(E:0x001000, 165)"))
        self.assertLess(script.index("BK *"), script.index("R7 = 90"))
        self.assertIn("MAP 0x020000,0xf6ffff READ WRITE", script)
        self.assertIn("MAP 0x020000,0xf6ffff READ WRITE", script)

