import json
from pathlib import Path
import tempfile
import unittest
import xml.etree.ElementTree as ET

from tests.simulator import simulator


ROOT = Path(__file__).resolve().parents[2]


class SimulatorTests(unittest.TestCase):
    def test_intel_hex_preserves_high_address_and_checksums(self):
        rendered = simulator.intel_hex(bytes(range(40)), 0xF8FFF0, 32)
        lines = rendered.splitlines()
        self.assertEqual(lines[0], ":0200000400F802")
        self.assertIn(":0200000400F901", lines)
        for line in lines:
            raw = bytes.fromhex(line[1:])
            self.assertEqual(sum(raw) & 0xFF, 0)

    def test_source_catalog_accounts_for_every_canonical_function(self):
        catalog = simulator.extract_source_functions(ROOT / "src")
        self.assertEqual(len(catalog), simulator.CANONICAL_FUNCTION_COUNT)
        self.assertEqual(catalog[0]["canonical_address"], "0xf80050")

    def test_resume_identity_tracks_case_content_but_not_source_path(self):
        first = [{"id": "case", "registers": {"R11": 1}, "case_file": "a.json"}]
        moved = [{"id": "case", "registers": {"R11": 1}, "case_file": "b.json"}]
        changed = [{"id": "case", "registers": {"R11": 2}, "case_file": "a.json"}]
        self.assertEqual(
            simulator.case_set_sha256(first), simulator.case_set_sha256(moved)
        )
        self.assertNotEqual(
            simulator.case_set_sha256(first), simulator.case_set_sha256(changed)
        )

    def test_function_report_results_accounts_once_for_every_function(self):
        catalog = [
            {
                "canonical_address": "0xf80050",
                "symbol": "First",
                "evidence": "smoke",
            },
            {
                "canonical_address": "0xf80060",
                "symbol": "Second",
                "evidence": "mismatch",
            },
            {
                "canonical_address": "0xf80070",
                "symbol": "Third",
                "evidence": "untested",
            },
        ]
        cases = [
            {"id": "first-a", "function": "0xf80050"},
            {"id": "first-b", "function": "0xf80050"},
            {"id": "second", "function": "0xf80060"},
        ]
        results = [
            {"id": "first-a", "status": "pass"},
            {"id": "first-b", "status": "pass"},
            {"id": "second", "status": "mismatch", "differences": ["ACC"]},
        ]
        report = simulator.function_report_results(catalog, cases, results)
        self.assertEqual(len(report), len(catalog))
        self.assertEqual(
            [entry["status"] for entry in report],
            ["pass", "mismatch", "untested"],
        )
        self.assertEqual(report[1]["differences"], ["ACC"])

    def test_committed_metadata_is_complete_and_matches_stock_firmware(self):
        metadata = simulator.load_metadata(
            ROOT / "tests/simulator/metadata/W5224A104.json",
            ROOT / "data/W5224A104/MONT_104.bin",
        )
        self.assertEqual(metadata["function_count"], simulator.CANONICAL_FUNCTION_COUNT)
        self.assertEqual(len(metadata["functions"]), simulator.CANONICAL_FUNCTION_COUNT)
        self.assertEqual(metadata["language"], "80251-fixed:BE:24:default")

    def test_metadata_rejects_the_wrong_stock_firmware(self):
        with tempfile.TemporaryDirectory() as temporary:
            stock = Path(temporary) / "wrong.bin"
            stock.write_bytes(b"\xff" * 0x80000)
            with self.assertRaisesRegex(simulator.SimulatorError, "SHA-256"):
                simulator.load_metadata(
                    ROOT / "tests/simulator/metadata/W5224A104.json", stock
                )

    def test_memory_application_provenance_rejects_a_stale_image(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            image = directory / "image.bin"
            application = directory / "firmware_memory.abs"
            provenance = directory / "firmware_memory.sha256"
            image.write_bytes(b"\x00" * 0x80000)
            application.write_bytes(b"abs")
            provenance.write_text(
                simulator.memory_application_identity(b"\x01" * 0x80000) + "\n",
                encoding="ascii",
            )
            with self.assertRaisesRegex(
                simulator.SimulatorError, "memory view does not match"
            ):
                simulator.validate_memory_application(image, application)

    def test_memory_application_provenance_accepts_the_exact_image(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            image = directory / "image.bin"
            application = directory / "firmware_memory.abs"
            provenance = directory / "firmware_memory.sha256"
            contents = b"\xa5" * 0x80000
            image.write_bytes(contents)
            application.write_bytes(b"abs")
            provenance.write_text(
                simulator.memory_application_identity(contents) + "\n",
                encoding="ascii",
            )
            simulator.validate_memory_application(image, application)

    def test_offline_inventory_and_generated_cases_account_for_all_functions(self):
        metadata = simulator.load_metadata(
            ROOT / "tests/simulator/metadata/W5224A104.json"
        )
        inventory = simulator.build_inventory(metadata)
        self.assertEqual(inventory["function_count"], 1717)
        self.assertEqual(sum(inventory["harness_counts"].values()), 1717)
        with tempfile.TemporaryDirectory() as temporary:
            output = Path(temporary) / "auto.json"
            args = type(
                "Arguments",
                (),
                {
                    "metadata": ROOT
                    / "tests/simulator/metadata/W5224A104.json",
                    "overrides": ROOT
                    / "tests/simulator/cases/generated-overrides.json",
                    "output": output,
                    "instruction_limit": 100000,
                },
            )()
            self.assertEqual(simulator.command_generate_cases(args), 0)
            generated = json.loads(output.read_text())
            self.assertEqual(generated["case_count"], 1717)
            self.assertEqual(
                generated["case_count"] + sum(generated["deferred"].values()),
                1717,
            )
            cases_by_id = {case["id"]: case for case in generated["cases"]}
            for case_id in (
                "auto-fa0000",
                "auto-fa05ef",
                "auto-fa0ab4",
                "auto-fa1341",
                "auto-fa1ac5",
                "auto-fa20f3",
                "auto-fa24e9",
            ):
                wait_dependency = next(
                    dependency
                    for dependency in cases_by_id[case_id]["dependencies"]
                    if isinstance(dependency, dict)
                    and dependency["function"] == "RAM:fbff86"
                )
                self.assertEqual(wait_dependency["return"]["value"], 1)
            self.assertEqual(cases_by_id["auto-fa0000"]["instruction_limit"], 250000)
            self.assertEqual(cases_by_id["auto-fa1ac5"]["wall_timeout"], 180)
            media_state_case = cases_by_id["auto-f85fdf"]
            media_state_dependencies = {
                dependency.get("function"): dependency
                for dependency in media_state_case["dependencies"]
                if isinstance(dependency, dict)
            }
            self.assertIn("RAM:fcf345", media_state_case["dependencies"])
            self.assertEqual(
                media_state_dependencies["RAM:f88a63"]["return"]["value"], 1
            )
            capacity_dependency = next(
                dependency
                for dependency in cases_by_id["auto-fa1ac5"]["dependencies"]
                if isinstance(dependency, dict)
                and dependency["function"] == "RAM:feaeca"
            )
            self.assertEqual(capacity_dependency["return"]["value"], 1)

    def test_hardware_dependencies_get_deterministic_register_results(self):
        metadata = {
            "functions": [
                {
                    "canonical_address": "0x100000",
                    "symbol": "Caller",
                    "calls": [
                        "RAM:100100",
                        "RAM:100200",
                        "RAM:100300",
                        "RAM:100400",
                    ],
                    "return_sites": ["RAM:100010:eret"],
                    "memory_references": [],
                },
                {
                    "canonical_address": "0x100100",
                    "symbol": "ReadHardware",
                    "calls": [],
                    "return_storage": "ACC:1",
                    "return_sites": ["RAM:100110:eret"],
                    "memory_references": ["SFR:00e3"],
                },
                {
                    "canonical_address": "0x100200",
                    "symbol": "WriteHardware",
                    "calls": [],
                    "return_storage": "<UNASSIGNED>",
                    "return_sites": ["RAM:100210:eret"],
                    "memory_references": ["RAM:018080"],
                },
                {
                    "canonical_address": "0x100300",
                    "symbol": "PureHelper",
                    "calls": [],
                    "return_storage": "DR4:4",
                    "return_sites": ["RAM:100310:eret"],
                    "memory_references": ["RAM:001000"],
                },
                {
                    "canonical_address": "0x100400",
                    "symbol": "HugeMemoryHelper",
                    "calls": [],
                    "return_storage": "<UNASSIGNED>",
                    "return_sites": ["RAM:100410:eret"],
                    "memory_references": ["RAM:2ba591"],
                },
            ]
        }
        self.assertEqual(
            simulator.hardware_coupled_dependencies(
                metadata["functions"][0], metadata
            ),
            [
                {
                    "function": "RAM:100100",
                    "return": {"register": "R11", "value": 0},
                },
                "RAM:100200",
                "RAM:100400",
            ],
        )

    def test_sparse_override_changes_one_generated_dependency_result(self):
        case = {
            "dependencies": [
                "RAM:100100",
                {
                    "function": "RAM:100200",
                    "return": {"register": "R11", "value": 0},
                },
            ]
        }
        simulator.apply_dependency_result_overrides(
            case, {"0x100200": 2}, Path("overrides.json")
        )
        self.assertEqual(case["dependencies"][1]["return"]["value"], 2)

    def test_sparse_override_rejects_non_array_additional_dependencies(self):
        with self.assertRaisesRegex(simulator.SimulatorError, "must be an array"):
            with tempfile.TemporaryDirectory() as temporary:
                override = Path(temporary) / "overrides.json"
                output = Path(temporary) / "auto.json"
                override.write_text(
                    json.dumps(
                        {
                            "schema_version": 1,
                            "overrides": {
                                "0xf80050": {"additional_dependencies": "bad"}
                            },
                        }
                    )
                )
                simulator.command_generate_cases(
                    type(
                        "Arguments",
                        (),
                        {
                            "metadata": ROOT
                            / "tests/simulator/metadata/W5224A104.json",
                            "overrides": override,
                            "output": output,
                            "instruction_limit": 100000,
                        },
                    )()
                )

    def test_sparse_override_marks_generated_dependency_nonreturning(self):
        case = {"dependencies": ["RAM:100100", "RAM:100200"]}
        simulator.apply_nonreturn_dependency_overrides(
            case, ["0x100200"], Path("overrides.json")
        )
        self.assertEqual(
            case["dependencies"],
            ["RAM:100100", {"function": "0x100200", "nonreturn": True}],
        )

    def test_sparse_override_adds_dependency_bit_writes(self):
        case = {"dependencies": ["RAM:100100", "RAM:100200"]}
        writes = [{"address": "0x0009", "value": 1}]
        simulator.apply_dependency_bit_write_overrides(
            case, {"RAM:100200": writes}, Path("overrides.json")
        )
        self.assertEqual(
            case["dependencies"],
            ["RAM:100100", {"function": "RAM:100200", "bit_writes": writes}],
        )

    def test_dependency_trace_normalizes_compiler_local_pointer_aliases(self):
        stock = [
            {"operation": "call", "arguments": {"source": 0x73}},
            {"operation": "call", "arguments": {"source16": 0x73}},
        ]
        reconstructed = [
            {"operation": "call", "arguments": {"source": 0x105A0}},
            {"operation": "call", "arguments": {"source16": 0x05A0}},
        ]
        names = {"source", "source16"}
        self.assertEqual(
            simulator.normalize_trace(stock, names),
            simulator.normalize_trace(reconstructed, names),
        )

    def test_direct_case_registers_follow_reconstructed_parameter_abi(self):
        case = {"registers": {"DR0": 0x1234, "R11": 3}}
        remapped = simulator.remap_direct_case_registers(
            case,
            (("destinationAddress", "DR0", 4), ("format", "R11", 1)),
            (("destination_address", "DR4", 4), ("format", "R11", 1)),
        )
        self.assertEqual(
            remapped["registers"],
            {"DR0": 0x1234, "DR4": 0x1234, "R11": 3},
        )
        self.assertEqual(case["registers"], {"DR0": 0x1234, "R11": 3})

    def test_resume_reuses_only_unchanged_cases_when_case_set_changes(self):
        first = {"id": "one", "function": "0xf80050", "value": 1}
        second = {"id": "two", "function": "0xf80054", "value": 2}
        old_identity = {
            "runner_sha256": "runner",
            "dependency_trace_sha256": "trace",
            "cases_sha256": "old",
            "case_ids_sha256": "ids",
            "case_count": 2,
            "shard_index": 0,
            "shard_count": 1,
        }
        new_identity = dict(old_identity, cases_sha256="new")
        previous = {
            "run_identity": old_identity,
            "results": [
                {
                    "id": "one",
                    "status": "pass",
                    "case_sha256": simulator.case_definition_sha256(first),
                },
                {
                    "id": "two",
                    "status": "pass",
                    "case_sha256": simulator.case_definition_sha256(second),
                },
            ],
        }
        changed_second = dict(second, value=3)
        reusable = simulator.reusable_results(
            previous, new_identity, [first, changed_second]
        )
        self.assertEqual([result["id"] for result in reusable], ["one"])

    def test_resume_rejects_results_when_global_input_changes(self):
        case = {"id": "one", "function": "0xf80050"}
        previous = {
            "run_identity": {
                "runner_sha256": "old",
                "cases_sha256": "cases",
            },
            "results": [
                {
                    "id": "one",
                    "status": "pass",
                    "case_sha256": simulator.case_definition_sha256(case),
                }
            ],
        }
        self.assertEqual(
            simulator.reusable_results(
                previous,
                {"runner_sha256": "new", "cases_sha256": "cases"},
                [case],
            ),
            [],
        )

    def test_direct_case_materializes_memory_backed_reconstructed_parameter(self):
        case = {"registers": {"B": 0x5A}, "memory": []}
        remapped = simulator.remap_direct_case_registers(
            case,
            (("exclusiveEnd", "B", 1),),
            (("exclusiveEnd", "XDATA@0x011a8b", 1),),
        )
        self.assertEqual(
            remapped["memory"],
            [{"address": "0x011a8b", "bytes": [0x5A]}],
        )
        self.assertEqual(
            remapped["ignored_memory"],
            [{"address": "0x011a8b", "length": 1}],
        )

    def test_memory_backed_parameter_resolves_from_linker_symbol(self):
        parameters = simulator.dependency_parameters(
            {
                "symbol": "Example",
                "parameters": ["exclusiveEnd:uchar:B:1"],
                "reconstructed_parameter_memory": {
                    "exclusiveEnd": "?Example??BYTE+9"
                },
            },
            "reconstructed",
            Path("unused.lst"),
            "Example",
            {"?Example??BYTE": 0x011A82},
        )
        self.assertEqual(parameters, (("exclusiveEnd", "XDATA@0x011a8b", 1),))

    def test_listing_parameter_parser_recovers_accumulator_spill(self):
        listing_text = """\
; FUNCTION Example? (BEGIN)
000000 900000 R MOV DPTR,#WORD0 target_mode
000003 F0 MOVX @DPTR,A ; A=R11
000004 7F31 MOV DR12,DR4
;---- Variable 'target_position' assigned to Register 'DR12' ----
000006 AA ERET
; FUNCTION Example? (END)
"""
        with tempfile.TemporaryDirectory() as temporary:
            listing = Path(temporary) / "example.lst"
            listing.write_text(listing_text, encoding="ascii")
            registers = simulator.parse_listing_parameter_registers(
                listing, "Example", {"targetmode", "targetposition"}
            )
        self.assertEqual(
            registers,
            {"targetposition": "DR4", "targetmode": "R11"},
        )

    def test_listing_parameter_parser_recovers_dword_register_spill(self):
        listing_text = """\
; FUNCTION Example? (BEGIN)
000000 900000 R MOV DPTR,#WORD0 buffer_address
000003 1BEA20 MOV @DR56,WR4
000006 793E0002 MOV @DR56+0x2,WR6
00000A AA ERET
; FUNCTION Example? (END)
"""
        with tempfile.TemporaryDirectory() as temporary:
            listing = Path(temporary) / "example.lst"
            listing.write_text(listing_text, encoding="ascii")
            registers = simulator.parse_listing_parameter_registers(
                listing, "Example", {"bufferaddress"}
            )
        self.assertEqual(registers, {"bufferaddress": "DR4"})

    def test_listing_parameter_parser_recovers_word_register_spill(self):
        listing_text = """\
; FUNCTION Example? (BEGIN)
000000 900000 R MOV DPTR,#WORD0 byte_count
000003 1BEA10 MOV @DR56,WR2
000006 7F31 MOV DR12,DR4
000008 AA ERET
; FUNCTION Example? (END)
"""
        with tempfile.TemporaryDirectory() as temporary:
            listing = Path(temporary) / "example.lst"
            listing.write_text(listing_text, encoding="ascii")
            registers = simulator.parse_listing_parameter_registers(
                listing, "Example", {"bytecount"}
            )
        self.assertEqual(registers, {"bytecount": "WR2"})

