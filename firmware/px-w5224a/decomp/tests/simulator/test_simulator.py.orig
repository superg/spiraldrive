    def test_function_listing_prefers_canonical_source_over_duplicate_helper(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            (directory / "alpha.lst").write_text(
                "; FUNCTION ReadBigEndianU16 (BEGIN)\n"
                "000000 22 RET\n"
                "; FUNCTION ReadBigEndianU16 (END)\n",
                encoding="ascii",
            )
            expected = directory / "memory.lst"
            expected.write_text(
                "; FUNCTION ReadBigEndianU16? (BEGIN)\n"
                "000010 AA ERET\n"
                "; FUNCTION ReadBigEndianU16? (END)\n",
                encoding="ascii",
            )
            listings = simulator.index_listings(directory)
            selected = simulator.function_listing(
                {"source": "src/platform/memory.c"},
                "ReadBigEndianU16",
                listings,
            )
        self.assertEqual(selected, expected)

    def test_a251_listing_functions_are_indexed_and_parsed(self):
        listing_text = """\
                         1     PUBLIC ResumeCoroutine0?
                         2     PUBLIC ResumeCoroutine1?
000000                   20     ResumeCoroutine0?:
000000 7AFF115A          21         MOV EDATA 115AH,SPX
000004 7EFF115E          22         MOV SPX,EDATA 115EH
000008 DA3B              23         POP DR12
00000A AA                24         ERET
00000B                   26     ResumeCoroutine1?:
00000B AA                27         ERET
"""
        with tempfile.TemporaryDirectory() as temporary:
            listing = Path(temporary) / "coroutine_context_switch.lst"
            listing.write_text(listing_text, encoding="ascii")
            indexed = simulator.index_listings(Path(temporary))
            rows = simulator.listing_function_rows(listing, "ResumeCoroutine0")
            instructions = simulator.parse_listing_instructions(
                listing, "ResumeCoroutine0"
            )
            parameter_registers = simulator.parse_listing_parameter_registers(
                listing, "ResumeCoroutine0", {"entrypoint"}
            )
        self.assertEqual(indexed["ResumeCoroutine0"], listing)
        self.assertEqual(indexed["ResumeCoroutine1"], listing)
        self.assertEqual(
            rows,
            [
                (0, bytes.fromhex("7aff115a")),
                (4, bytes.fromhex("7eff115e")),
                (8, bytes.fromhex("da3b")),
                (10, bytes.fromhex("aa")),
            ],
        )
        self.assertEqual(
            instructions,
            [(0, "mov"), (4, "mov"), (8, "pop"), (10, "eret")],
        )
        self.assertEqual(parameter_registers, {})

    def test_a251_function_block_retains_internal_labels(self):
        listing_text = """\
                         1     PUBLIC CopyWords?
                         2     PUBLIC Following?
000000                    3     CopyWords?:
000000 8000               4         SJMP CopyWordsTest
000002                    5     CopyWordsBody:
000002 00                 6         NOP
000003                    7     CopyWordsTest:
000003 AA                 8         ERET
000004                    9     Following?:
000004 AA                10         ERET
"""
        with tempfile.TemporaryDirectory() as temporary:
            listing = Path(temporary) / "native.lst"
            listing.write_text(listing_text, encoding="ascii")
            rows = simulator.listing_function_rows(listing, "CopyWords")
            indexed = simulator.index_listings(Path(temporary))
        self.assertEqual(
            rows,
            [
                (0, bytes.fromhex("8000")),
                (2, bytes.fromhex("00")),
                (3, bytes.fromhex("aa")),
            ],
        )
        self.assertNotIn("CopyWordsBody", indexed)
        self.assertNotIn("CopyWordsTest", indexed)

