    def test_reconstructed_hardware_difference_is_reported_as_a_mismatch(self):
        case = {
            "id": "hardware-difference",
            "hardware_reads": [],
            "hardware_writes": [
                {
                    "space": "SFR",
                    "address": "0x00e1",
                    "values": [0, 128, 0],
                }
            ],
        }
        trace = bytearray(12)
        trace[0] = 1
        trace[4] = 2
        trace[5] = 1
        trace[9] = 0xE1
        trace[10] = 1
        trace[11] = 0
        with tempfile.TemporaryDirectory() as temporary:
            path = Path(temporary) / "hardware.hex"
            path.write_text(
                simulator.intel_hex(bytes(trace), simulator.HARDWARE_TRACE_BASE)
            )
            with self.assertRaises(simulator.SimulatorError):
                simulator.decode_hardware_trace(case, path)
            actual = simulator.decode_hardware_trace(
                case, path, validate_contract=False
            )
        self.assertEqual(len(actual), 1)
        self.assertEqual(actual[0]["address"], "0x0000e1")

